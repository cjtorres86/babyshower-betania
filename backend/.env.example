# Service URI de tu MySQL en Aiven (pestaña "Overview" del servicio)
DATABASE_URL=mysql://avnadmin:TU_CLAVE@mysql-xxxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# (Opcional) Contenido del "CA certificate" de Aiven para validar SSL.
# Puedes pegarlo en una sola línea usando \n para los saltos de línea.
DB_CA_CERT=

# Contraseña para entrar al panel /admin
ADMIN_PASSWORD=cambia-esta-clave

# Texto largo y aleatorio para firmar las sesiones del admin
JWT_SECRET=pon-aqui-un-texto-largo-y-secreto

# URL de tu frontend en Vercel (puedes poner varias separadas por coma)
FRONTEND_URL=https://babyshower-betania.vercel.app

# Pon "false" si NO quieres que se carguen regalos de ejemplo la primera vez
SEED_DEFAULT_GIFTS=true

PORT=4000
